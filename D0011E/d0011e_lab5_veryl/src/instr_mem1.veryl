module InstrMem1 (
    i_addr : input  logic<32>,
    o_instr: output logic<32>,
) {
    assign o_instr = case i_addr {
        // ===== Lab 4 program =====
        32'h0000_0000: 32'b001000_00001_00000_0000000000000100, // 00 addi r0,r1,4  (nop)
        32'h0000_0004: 32'b001000_00001_00000_1111111111111000, // 04 addi r0,r1,-8 (nop)
        32'h0000_0008: 32'b001000_00010_00001_0000000000001000, // 08 addi r1,r2,8
        32'h0000_000c: 32'b000000_00000_00001_00010_00000_100000, // 0c add  r2,r0,r1
        32'h0000_0010: 32'b001000_00000_00010_0000000000000010, // 10 addi r2,r0,2
        32'h0000_0014: 32'b000000_00010_00001_00011_00000_100010, // 14 sub  r3,r2,r1
        32'h0000_0018: 32'b000000_00000_00011_00100_00000_101010, // 18 slt  r4,r0,r3
        32'h0000_001c: 32'b001010_00011_00100_1111111111111011, // 1c slti r4,r3,-5
        32'h0000_0020: 32'b000000_00000_00100_00101_00000_101010, // 20 slt  r5,r0,r4
        32'h0000_0024: 32'b000000_00011_00000_00110_00000_100101, // 24 or   r6,r3,r0
        32'h0000_0028: 32'b000000_00001_00011_00111_00000_100100, // 28 and  r7,r1,r3
        32'h0000_002c: 32'b000000_00001_00011_01000_00000_100111, // 2c nor  r8,r1,r3

        // ===== Part 2: SW / LW =====
        32'h0000_0030: 32'b101011_00111_00010_0000000000000000, // 30 sw r2,0(r7)
        32'h0000_0034: 32'b100011_00111_01000_0000000000000000, // 34 lw r8,0(r7)
        32'h0000_0038: 32'b101011_01001_00011_0000000000000100, // 38 sw r3,4(r9)
        32'h0000_003c: 32'b100011_01010_01001_0000000000000100, // 3c lw r9,4(r10)

        // ===== Part 3: SUB + BEQ =====
        32'h0000_0040: 32'b000000_00010_00100_00010_00000_100010, // 40 sub r2,r2,r4
        32'h0000_0044: 32'b000100_00010_00100_1111111111111110, // 44 beq r2,r4,-2

        // ===== Division 1: N=12, D=5 =====
        32'h0000_0048: 32'b001000_00000_01100_0000000000000000, // 48 addi r12,r0,0
        32'h0000_004c: 32'b001000_00000_01101_0000000000001100, // 4c addi r13,r0,12
        32'h0000_0050: 32'b001000_00000_01011_0000000000000101, // 50 addi r11,r0,5
        32'h0000_0054: 32'b000000_01101_01011_01110_00000_101010, // 54 slt r14,r13,r11
        32'h0000_0058: 32'b000100_01110_00000_0000000000000001, // 58 beq r14,r0,+1
        32'h0000_005c: 32'b000010_00000000000000000000011011, // 5c j 0x6C
        32'h0000_0060: 32'b001000_01100_01100_0000000000000001, // 60 addi r12,r12,1
        32'h0000_0064: 32'b000000_01101_01011_01101_00000_100010, // 64 sub r13,r13,r11
        32'h0000_0068: 32'b000010_00000000000000000000010101, // 68 j 0x54
        32'h0000_006c: 32'b001000_00000_01111_0000000001111100, // 6c addi r15,r0,124
        32'h0000_0070: 32'b101011_01111_01100_0000000000000000, // 70 sw r12,0(r15)
        32'h0000_0074: 32'b001000_00000_01111_0000000001111000, // 74 addi r15,r0,120
        32'h0000_0078: 32'b101011_01111_01101_0000000000000000, // 78 sw r13,0(r15)

        // ===== Division 2: N=12, D=12 =====
        32'h0000_007c: 32'b001000_00000_01100_0000000000000000, // 7c addi r12,r0,0
        32'h0000_0080: 32'b001000_00000_01101_0000000000001100, // 80 addi r13,r0,12
        32'h0000_0084: 32'b001000_00000_01011_0000000000001100, // 84 addi r11,r0,12
        32'h0000_0088: 32'b000000_01101_01011_01110_00000_101010, // 88 slt r14,r13,r11
        32'h0000_008c: 32'b000100_01110_00000_0000000000000001, // 8c beq r14,r0,+1
        32'h0000_0090: 32'b000010_00000000000000000000101000, // 90 j 0xA0
        32'h0000_0094: 32'b001000_01100_01100_0000000000000001, // 94 addi r12,r12,1
        32'h0000_0098: 32'b000000_01101_01011_01101_00000_100010, // 98 sub r13,r13,r11
        32'h0000_009c: 32'b000010_00000000000000000000100010, // 9c j 0x88
        32'h0000_00a0: 32'b001000_00000_01111_0000000001110000, // a0 addi r15,r0,112
        32'h0000_00a4: 32'b101011_01111_01100_0000000000000000, // a4 sw r12,0(r15)
        32'h0000_00a8: 32'b001000_00000_01111_0000000001101100, // a8 addi r15,r0,108
        32'h0000_00ac: 32'b101011_01111_01101_0000000000000000, // ac sw r13,0(r15)

        // ===== Division 3: N=5, D=12 =====
        32'h0000_00b0: 32'b001000_00000_01100_0000000000000000, // b0 addi r12,r0,0
        32'h0000_00b4: 32'b001000_00000_01101_0000000000000101, // b4 addi r13,r0,5
        32'h0000_00b8: 32'b001000_00000_01011_0000000000001100, // b8 addi r11,r0,12
        32'h0000_00bc: 32'b000000_01101_01011_01110_00000_101010, // bc slt r14,r13,r11
        32'h0000_00c0: 32'b000100_01110_00000_0000000000000001, // c0 beq r14,r0,+1
        32'h0000_00c4: 32'b000010_00000000000000000000110100, // c4 j 0xD0
        32'h0000_00c8: 32'b001000_01100_01100_0000000000000001, // c8 addi r12,r12,1
        32'h0000_00cc: 32'b000010_00000000000000000000101111, // cc j 0xBC
        32'h0000_00d0: 32'b001000_00000_01111_0000000001101000, // d0 addi r15,r0,104
        32'h0000_00d4: 32'b101011_01111_01100_0000000000000000, // d4 sw r12,0(r15)
        32'h0000_00d8: 32'b001000_00000_01111_0000000001100100, // d8 addi r15,r0,100
        32'h0000_00dc: 32'b101011_01111_01101_0000000000000000, // dc sw r13,0(r15)

        default: 32'b000000_00000_00000_00000_00000_100000, // NOP
    };
}

#[test(instr_mem1)]
module InstrMem1Test {
    inst clk : $tb::clock_gen #( period: 10 );
    var addr : logic<32>;
    var instr: logic<32>;

    inst dut: InstrMem1 (
        i_addr : addr ,
        o_instr: instr,
    );

    var op   : logic<6> ;
    var funct: logic<6> ;
    var rs   : logic<5> ;
    var rt   : logic<5> ;
    var rd   : logic<5> ;
    var imm  : logic<16>;

    always_comb {
        op    = instr[31:26];
        rs    = instr[25:21];
        rt    = instr[20:16];
        rd    = instr[15:11];
        imm   = instr[15:0];
        funct = instr[5:0];
    }

    initial {
        addr = 32'h0000_0008;
        clk.next();
        $assert(op == 6'd8 && rs == 5'd2 && rt == 5'd1 && imm == 16'd8);

        addr = 32'h0000_0030;
        clk.next();
        $assert(op == 6'd43);

        addr = 32'h0000_0044;
        clk.next();
        $assert(op == 6'd4);

        addr = 32'h0000_005c;
        clk.next();
        $assert(op == 6'd2);

        $finish();
    }
}
