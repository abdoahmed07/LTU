module bcdcheck3 (
    x    : input  logic<4>,
    max  : output logic   ,
    min  : output logic   ,
    even : output logic   ,
    lo3  : output logic   ,
    noBCD: output logic   ,
    hieq3: output logic   ,
) {
    assign max   = x == 9;
    assign min   = x == 0;
    assign even  = !x[0];
    assign lo3   = x <: 3;
    assign noBCD = x >: 9 & x <= 15;
    assign hieq3 = !lo3 & !noBCD;
}

#[test(bcdcheck3_test)]
module bcdcheck3_test {
    // we do not use the clock, but this will make the waveform nice
    inst clk: $tb::clock_gen #( period: 10 );

    var x: logic<4>;

    var d_max  : logic;
    var d_min  : logic;
    var d_even : logic;
    var d_lo3  : logic;
    var d_noBCD: logic;
    var d_hieq3: logic;

    inst dut: bcdcheck3 (
        x    : x      ,
        max  : d_max  ,
        min  : d_min  ,
        even : d_even ,
        lo3  : d_lo3  ,
        noBCD: d_noBCD,
        hieq3: d_hieq3,
    );

    initial {

        x[3]     = 0;
        x[2]     = 0;
        x[1]     = 0;
        x[0]     = 0;
        clk.next();
        $assert (d_max == 0, "wrong output max for 0000");
        $assert (d_min == 1, "wrong output min for 0000");
        $assert (d_even == 1, "wrong output even for 0000");
        $assert (d_lo3 == 1, "wrong output lo3 for 0000");
        $assert (d_noBCD == 0, "wrong output noBCD for 0000");
        $assert (d_hieq3 == 0, "wrong output hieq3 for 0000");

        x[3]     = 0;
        x[2]     = 0;
        x[1]     = 0;
        x[0]     = 1;
        clk.next();
        $assert (d_max == 0, "wrong output max for 0001");
        $assert (d_min == 0, "wrong output min for 0001");
        $assert (d_even == 0, "wrong output even for 0001");
        $assert (d_lo3 == 1, "wrong output lo3 for 0001");
        $assert (d_noBCD == 0, "wrong output noBCD for 0001");
        $assert (d_hieq3 == 0, "wrong output hieq3 for 0001");

        x[3]     = 0;
        x[2]     = 0;
        x[1]     = 1;
        x[0]     = 0;
        clk.next();
        $assert (d_max == 0, "wrong output max for 0010");
        $assert (d_min == 0, "wrong output min for 0010");
        $assert (d_even == 1, "wrong output even for 0010");
        $assert (d_lo3 == 1, "wrong output lo3 for 0010");
        $assert (d_noBCD == 0, "wrong output noBCD for 0010");
        $assert (d_hieq3 == 0, "wrong output hieq3 for 0010");

        x[3]     = 0;
        x[2]     = 0;
        x[1]     = 1;
        x[0]     = 1;
        clk.next();
        $assert (d_max == 0, "wrong output max for 0011");
        $assert (d_min == 0, "wrong output min for 0011");
        $assert (d_even == 0, "wrong output even for 0011");
        $assert (d_lo3 == 0, "wrong output lo3 for 0011");
        $assert (d_noBCD == 0, "wrong output noBCD for 0011");
        $assert (d_hieq3 == 1, "wrong output hieq3 for 0011");

        x[3]     = 0;
        x[2]     = 1;
        x[1]     = 0;
        x[0]     = 0;
        clk.next();
        $assert (d_max == 0, "wrong output max for 0100");
        $assert (d_min == 0, "wrong output min for 0100");
        $assert (d_even == 1, "wrong output even for 0100");
        $assert (d_lo3 == 0, "wrong output lo3 for 0100");
        $assert (d_noBCD == 0, "wrong output noBCD for 0100");
        $assert (d_hieq3 == 1, "wrong output hieq3 for 0100");

        x[3]     = 0;
        x[2]     = 1;
        x[1]     = 0;
        x[0]     = 1;
        clk.next();
        $assert (d_max == 0, "wrong output max for 0101");
        $assert (d_min == 0, "wrong output min for 0101");
        $assert (d_even == 0, "wrong output even for 0101");
        $assert (d_lo3 == 0, "wrong output lo3 for 0101");
        $assert (d_noBCD == 0, "wrong output noBCD for 0101");
        $assert (d_hieq3 == 1, "wrong output hieq3 for 0101");

        x[3]     = 0;
        x[2]     = 1;
        x[1]     = 1;
        x[0]     = 0;
        clk.next();
        $assert (d_max == 0, "wrong output max for 0110");
        $assert (d_min == 0, "wrong output min for 0110");
        $assert (d_even == 1, "wrong output even for 0110");
        $assert (d_lo3 == 0, "wrong output lo3 for 0110");
        $assert (d_noBCD == 0, "wrong output noBCD for 0110");
        $assert (d_hieq3 == 1, "wrong output hieq3 for 0110");

        x[3]     = 0;
        x[2]     = 1;
        x[1]     = 1;
        x[0]     = 1;
        clk.next();
        $assert (d_max == 0, "wrong output max for 0111");
        $assert (d_min == 0, "wrong output min for 0111");
        $assert (d_even == 0, "wrong output even for 0111");
        $assert (d_lo3 == 0, "wrong output lo3 for 0111");
        $assert (d_noBCD == 0, "wrong output noBCD for 0111");
        $assert (d_hieq3 == 1, "wrong output hieq3 for 0111");

        x[3]     = 1;
        x[2]     = 0;
        x[1]     = 0;
        x[0]     = 0;
        clk.next();
        $assert (d_max == 0, "wrong output max for 1000");
        $assert (d_min == 0, "wrong output min for 1000");
        $assert (d_even == 1, "wrong output even for 1000");
        $assert (d_lo3 == 0, "wrong output lo3 for 1000");
        $assert (d_noBCD == 0, "wrong output noBCD for 1000");
        $assert (d_hieq3 == 1, "wrong output hieq3 for 1000");

        x[3]     = 1;
        x[2]     = 0;
        x[1]     = 0;
        x[0]     = 1;
        clk.next();
        $assert (d_max == 1, "wrong output max for 1001");
        $assert (d_min == 0, "wrong output min for 1001");
        $assert (d_even == 0, "wrong output even for 1001");
        $assert (d_lo3 == 0, "wrong output lo3 for 1001");
        $assert (d_noBCD == 0, "wrong output noBCD for 1001");
        $assert (d_hieq3 == 1, "wrong output hieq3 for 1001");

        x[3]     = 1;
        x[2]     = 0;
        x[1]     = 1;
        x[0]     = 0;
        clk.next();
        $assert (d_max == 0, "wrong output max for 1010");
        $assert (d_min == 0, "wrong output min for 1010");
        $assert (d_even == 1, "wrong output even for 1010");
        $assert (d_lo3 == 0, "wrong output lo3 for 1010");
        $assert (d_noBCD == 1, "wrong output noBCD for 1010");
        $assert (d_hieq3 == 0, "wrong output hieq3 for 1010");

        x[3]     = 1;
        x[2]     = 0;
        x[1]     = 1;
        x[0]     = 1;
        clk.next();
        $assert (d_max == 0, "wrong output max for 1011");
        $assert (d_min == 0, "wrong output min for 1011");
        $assert (d_even == 0, "wrong output even for 1011");
        $assert (d_lo3 == 0, "wrong output lo3 for 1011");
        $assert (d_noBCD == 1, "wrong output noBCD for 1011");
        $assert (d_hieq3 == 0, "wrong output hieq3 for 1011");

        x[3]     = 1;
        x[2]     = 1;
        x[1]     = 0;
        x[0]     = 0;
        clk.next();
        $assert (d_max == 0, "wrong output max for 1100");
        $assert (d_min == 0, "wrong output min for 1100");
        $assert (d_even == 1, "wrong output even for 1100");
        $assert (d_lo3 == 0, "wrong output lo3 for 1100");
        $assert (d_noBCD == 1, "wrong output noBCD for 1100");
        $assert (d_hieq3 == 0, "wrong output hieq3 for 1100");

        x[3]     = 1;
        x[2]     = 1;
        x[1]     = 0;
        x[0]     = 1;
        clk.next();
        $assert (d_max == 0, "wrong output max for 1101");
        $assert (d_min == 0, "wrong output min for 1101");
        $assert (d_even == 0, "wrong output even for 1101");
        $assert (d_lo3 == 0, "wrong output lo3 for 1101");
        $assert (d_noBCD == 1, "wrong output noBCD for 1101");
        $assert (d_hieq3 == 0, "wrong output hieq3 for 1101");

        x[3]     = 1;
        x[2]     = 1;
        x[1]     = 1;
        x[0]     = 0;
        clk.next();
        $assert (d_max == 0, "wrong output max for 1110");
        $assert (d_min == 0, "wrong output min for 1110");
        $assert (d_even == 1, "wrong output even for 1110");
        $assert (d_lo3 == 0, "wrong output lo3 for 1110");
        $assert (d_noBCD == 1, "wrong output noBCD for 1110");
        $assert (d_hieq3 == 0, "wrong output hieq3 for 1110");

        x[3]     = 1;
        x[2]     = 1;
        x[1]     = 1;
        x[0]     = 1;
        clk.next();
        $assert (d_max == 0, "wrong output max for 1111");
        $assert (d_min == 0, "wrong output min for 1111");
        $assert (d_even == 0, "wrong output even for 1111");
        $assert (d_lo3 == 0, "wrong output lo3 for 1111");
        $assert (d_noBCD == 1, "wrong output noBCD for 1111");
        $assert (d_hieq3 == 0, "wrong output hieq3 for 1111");

        $finish();
    }
}
