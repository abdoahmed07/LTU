module FullAdder (
    a    : input  logic,
    b    : input  logic,
    c_in : input  logic,
    r    : output logic,
    c_out: output logic,

) {
    assign r     = a ^ b ^ c_in;
    assign c_out = (a & b) | (a & c_in) | (b & c_in);
}
#[test(Fulladder_test)]
module Fulladder_test {
    inst clk : $tb::clock_gen #( period: 10 );
    var a   : logic;
    var b   : logic;
    var c_in: logic;

    var r    : logic;
    var c_out: logic;

    inst dut: FullAdder (
        a      ,
        b      ,
        c_in   ,
        r      ,
        c_out  ,
    );
    initial {
        a        = 0;
        b        = 0;
        c_in     = 0;
        clk.next();
        $assert (r == 0 && c_out == 0, "Wrong value for 000");

        a        = 0;
        b        = 0;
        c_in     = 1;
        clk.next();
        $assert (r == 1 && c_out == 0, "Wrong value for 001");

        a        = 0;
        b        = 1;
        c_in     = 0;
        clk.next();
        $assert (r == 1 && c_out == 0, "Wrong value for 010");

        a        = 0;
        b        = 1;
        c_in     = 1;
        clk.next();
        $assert (r == 0 && c_out == 1, "Wrong value for 011");

        a        = 1;
        b        = 0;
        c_in     = 0;
        clk.next();
        $assert (r == 1 && c_out == 0, "Wrong value for 100");

        a        = 1;
        b        = 0;
        c_in     = 1;
        clk.next();
        $assert (r == 0 && c_out == 1, "Wrong value for 101");

        a        = 1;
        b        = 1;
        c_in     = 0;
        clk.next();
        $assert (r == 0 && c_out == 1, "Wrong value for 110");

        a        = 1;
        b        = 1;
        c_in     = 1;
        clk.next();
        $assert (r == 1 && c_out == 1, "Wrong value for 111");

        $finish();
    }
}
